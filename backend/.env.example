# ─── Urban Furniture — backend environment ───
# Copy to .env and fill in. NEVER commit .env.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Extra browser origins for companion apps (comma-separated).
# Native apps send no Origin header and don't need this — they use a bearer token.
# In development any localhost port is allowed automatically.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ─── Database (local PostgreSQL 16) ───
DATABASE_URL="postgresql://urban:urban@localhost:5432/urbanfurniture?schema=public"

# ─── Auth ───
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=uf_token

# ─── Accounting ───
BASE_CURRENCY=INR
# Block posting a delivery that would drive stock negative (recommended: true)
BLOCK_NEGATIVE_STOCK=true

# ─── Odoo ERP integration (optional — app degrades gracefully if absent) ───
ERP_ENABLED=false
ERP_BASE_URL=http://localhost:8069
ERP_DB=urban_erp
ERP_USER=admin
ERP_PASSWORD=admin
ERP_TIMEOUT_MS=2500

# ─── AI agent (optional) ───
# Powers the read-only voice assistant (mic icon in the topbar): it turns a
# spoken phrase into "which screen do I open, with which filters". Any
# OpenAI-compatible endpoint works.
#   Cloud default:  https://api.groq.com/openai/v1   (free key: console.groq.com)
#   Local/offline:  http://localhost:11434/v1        (ollama run llama3.1:8b)
# Only the spoken phrase is sent — never ledger figures, contacts or documents.
# With AI_ENABLED=false the assistant simply reports that it isn't configured.
AI_ENABLED=false
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
