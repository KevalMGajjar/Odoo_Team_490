# ─── Urban Furniture — backend environment ───
# Copy to .env and fill in. NEVER commit .env.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Extra browser origins for companion apps (comma-separated).
# Native apps send no Origin header and don't need this — they use a bearer token.
# In development any localhost port is allowed automatically.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ─── Database (local PostgreSQL 16) ───
DATABASE_URL="postgresql://urban:urban@localhost:5432/urbanfurniture?schema=public"

# ─── Auth ───
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=uf_token

# ─── Accounting ───
BASE_CURRENCY=INR
# Block posting a delivery that would drive stock negative (recommended: true)
BLOCK_NEGATIVE_STOCK=true

# ─── Odoo ERP integration (optional — app degrades gracefully if absent) ───
ERP_ENABLED=false
ERP_BASE_URL=http://localhost:8069
ERP_DB=urban_erp
ERP_USER=admin
ERP_PASSWORD=admin
ERP_TIMEOUT_MS=2500

# ─── AI agent (optional) ───
# Powers the read-only voice assistant (mic icon in the topbar): it turns a
# spoken phrase into "which screen do I open, with which filters". Any
# OpenAI-compatible endpoint works.
#   Cloud default:  https://api.groq.com/openai/v1   (free key: console.groq.com)
#   Local/offline:  http://localhost:11434/v1        (ollama run llama3.1:8b)
# Only the spoken phrase is sent — never ledger figures, contacts or documents.
# With AI_ENABLED=false the assistant simply reports that it isn't configured.
AI_ENABLED=false
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b

# ─── Email (optional — controls how sign-in codes are delivered) ───
# Signing in needs a 6-digit code sent to the account's email address.
# With SMTP_HOST unset, codes are written to the `outbox` table only, and in
# development the code comes back in the API response so an offline install is
# still usable. Set these to send real mail.
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<address>,
#          SMTP_PASS=<a 16-character App Password, NOT the account password —
#          Google rejects the account password over SMTP>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Urban Furniture <no-reply@urbanfurniture.local>

# Accounts that skip the code, comma-separated. These are the seeded demo
# logins, whose mailboxes nobody trying the app can open. Every other account —
# including anything created through signup — gets the code.
OTP_BYPASS_LOGIN_IDS=admin01,accountant1,nimesh01
