{
  "name": "urban-furniture-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Urban Furniture Accounting System \u2014 API, general ledger, inventory valuation, multi-currency",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "seed": "node src/db/seed.js",
    "snapshot": "node src/db/snapshot.js dump",
    "restore": "node src/db/snapshot.js restore",
    "verify": "node src/db/verify-ledger.js && node src/db/verify-voucher.js && node src/db/verify-documents.js",
    "verify:ledger": "node src/db/verify-ledger.js",
    "verify:voucher": "node src/db/verify-voucher.js",
    "verify:documents": "node src/db/verify-documents.js",
    "verify:api": "node src/db/verify-api.js",
    "files": "node src/db/files.js",
    "demo": "node src/db/demo.js",
    "sync": "node src/db/sync.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^10.0.0",
    "opossum": "^10.0.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "xmlrpc": "^1.3.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3"
  }
}
