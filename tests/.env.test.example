# Test Environment Configuration
# Copy this file to .env.test and fill in values.
# NEVER commit .env.test — it's gitignored.

# ── Backend API ──
API_URL=http://localhost:4000

# ── Frontend ──
FRONTEND_URL=http://localhost:3000

# ── Test Database ──
# Use a SEPARATE database from the dev/prod one to avoid collisions
# with the existing verify-ledger / verify-voucher / verify-documents suites.
# Create it with:  CREATE DATABASE urban_furniture_test;
# Then point this URL at it.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/urban_furniture_test

# ── Test Credentials (must match the seed data) ──
ADMIN_EMAIL=admin@urbanfurniture.com
ADMIN_PASSWORD=demo123
ACCOUNTANT_EMAIL=accountant@urbanfurniture.com
ACCOUNTANT_PASSWORD=demo123
VIEWER_EMAIL=viewer@urbanfurniture.com
VIEWER_PASSWORD=demo123
PORTAL_EMAIL=nimesh@example.com
PORTAL_PASSWORD=demo123
